# Template for the environment variables zocare needs.
# Copy this file to `.env.local` and replace the values with your own.
# `.env.local` is gitignored so your real keys are never committed.

# Your Supabase project URL, e.g. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Supabase publishable key (starts with `sb_publishable_`).
# The legacy "anon" key also works here during the transition period.
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
